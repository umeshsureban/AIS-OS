# Hostinger SSH connection settings
# Copy these values into .env (which is gitignored) and replace the placeholders.
# Prefer SSH key authentication. Do not commit real credentials or private keys.

HOSTINGER_SSH_HOST=your-server.hostinger.com
HOSTINGER_SSH_PORT=22
HOSTINGER_SSH_USER=your-ssh-username

# Absolute path on this computer to your private SSH key.
# Example: C:/Users/DELL/.ssh/hostinger_ed25519
HOSTINGER_SSH_KEY_PATH=

# Leave blank when using an SSH key. Never share this value.
HOSTINGER_SSH_PASSWORD=

# Optional: directory on the Hostinger server where the site/project lives.
HOSTINGER_PROJECT_PATH=/home/your-ssh-username/public_html

# Optional: fingerprint/known-hosts file for host verification.
HOSTINGER_KNOWN_HOSTS_PATH=
